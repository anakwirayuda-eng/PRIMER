{
  "name": "primera-desktop",
  "version": "1.0.0",
  "description": "PRIMERA: Puskesmas Pagi — Primary Care Simulator & Arena, game desktop simulasi dokter Puskesmas untuk pendidikan kedokteran Indonesia",
  "main": "out/main/index.js",
  "author": "Anak Agung Bagus Wirayuda, MD, PhD",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bgm-license": "node scripts/check-bgm-license.js",
    "cohort:manifest": "vite-node --config vitest.config.ts scripts/generate-cohort-manifest.ts",
    "exam:simulate": "vite-node --config vitest.config.ts scripts/simulate-exam-blueprint.ts",
    "audit:editorial": "vite-node --config vitest.config.ts scripts/audit-editorial.ts",
    "m13:kfa": "vite-node --config vitest.config.ts scripts/m13-adjudication/harvest-kfa.ts",
    "m13:adjudication": "vite-node --config vitest.config.ts scripts/m13-adjudication/generate.ts",
    "pack": "npm run check:bgm-license && electron-vite build && electron-builder --win --dir",
    "dist": "npm run check:bgm-license && electron-vite build && electron-builder --win nsis"
  },
  "build": {
    "appId": "id.ac.its.medics.primer.testbeta",
    "productName": "PRIMERA test-beta",
    "copyright": "© 2026 Anak Agung Bagus Wirayuda MD PhD. Hak Cipta Terdaftar — No. EC002026019623.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "shortcutName": "PRIMERA test-beta"
    }
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
